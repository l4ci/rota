#!/usr/bin/env bash
# Fake codex for tests. SAFE BY CONSTRUCTION: it prints canned text and reads
# one marker file (or runs the opt-in scripted skill worker), without touching
# ~/.codex. Never put the real codex on a test's PATH.
#   --version      prints `codex-cli $ROTA_FAKE_CODEX_VERSION` (default 0.159.2)
#   --help         lists the launch flags rota uses, minus $ROTA_FAKE_CODEX_LACKS
#   login status   exit 0 when "$CODEX_HOME/.fake-logged-in" exists, else
#                  "Not logged in" and exit 1. With CODEX_HOME unset it reads
#                  $FAKE_DEFAULT_CODEX_HOME (the stand-in for the default
#                  Codex home); with neither set it is "Not logged in".
#   exec --json <prompt>  opt-in contract fixture; never invokes a model
case "$1 $2" in
  "exec --json")
    [ "${ROTA_FAKE_CODEX_SKILLS:-}" = 1 ] || { echo "fake codex: skill worker is not enabled" >&2; exit 98; }
    shift 2
    exec python3 "$(dirname "$0")/codex_skill_worker.py" "$@" ;;
  "--version"*) echo "codex-cli ${ROTA_FAKE_CODEX_VERSION:-0.159.2}" ;;
  "--help"*)
    echo "Usage: codex [OPTIONS]"
    for f in --model --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --no-daemon --no-alt-screen; do
      [ "$f" = "${ROTA_FAKE_CODEX_LACKS:-}" ] || echo "      $f"
    done ;;
  "login status")
    CH="${CODEX_HOME:-${FAKE_DEFAULT_CODEX_HOME:-}}"
    if [ -n "$CH" ] && [ -f "$CH/.fake-logged-in" ]; then echo "Logged in using ChatGPT"; else echo "Not logged in"; exit 1; fi ;;
  *) echo "fake codex: unsupported call: $*" >&2; exit 98 ;;
esac
