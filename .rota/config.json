{
  "models": {
    "orchestrator": "opus",
    "worker": "sonnet"
  },
  "work": {
    "isolation": "branch",
    "mergeStrategy": "direct"
  },
  "refactor": {
    "confirmBeforeExecute": true,
    "verifyCommands": [
      "python3 test/validate-skills.py",
      "go vet ./...",
      "go test -race -timeout 30m ./...",
      "out=$(bash test/smoke.sh 2>&1); rc=$?; printf '%s\\n' \"$out\" | tail -n 40; [ $rc -eq 0 ] && printf '%s' \"$out\" | grep -q 'All smoke tests passed.'"
    ]
  },
  "learn": {
    "verify": true,
    "promoteThreshold": 3
  },
  "ship": {
    "review": true,
    "secondOpinion": false,
    "qa": false
  },
  "autonomy": {
    "level": "auto"
  },
  "debug": {
    "competingHypotheses": false
  },
  "docs": {
    "path": "docs",
    "autoCreate": true,
    "afterWork": true
  },
  "umbrella": {
    "enabled": false
  },
  "git": {
    "baseBranch": ""
  },
  "qa": {
    "gate": "advisory",
    "afterWork": false
  },
  "issues": {
    "providers": {
      "github": true,
      "gitlab": true
    },
    "provider": "github"
  },
  "rota": {
    "version": "0.9.0"
  },
  "backlog": {
    "backend": "issues"
  }
}
