{
  "models": {
    "orchestrator": "opus",
    "worker": "sonnet"
  },
  "work": {
    "isolation": "branch",
    "mergeStrategy": "direct"
  },
  "refactor": {
    "confirmBeforeExecute": true
  },
  "learn": {
    "verify": true,
    "promoteThreshold": 3
  },
  "ship": {
    "review": "light",
    "secondOpinion": false,
    "secondOpinionRunner": "subagent",
    "qa": false
  },
  "autonomy": {
    "level": "auto"
  },
  "docs": {
    "path": "docs",
    "autoCreate": true,
    "afterWork": true
  },
  "umbrella": {
    "enabled": false
  },
  "git": {
    "baseBranch": ""
  },
  "qa": {
    "gate": "advisory",
    "afterWork": false
  },
  "issues": {
    "source": "github"
  },
  "rota": {
    "version": "0.21.0"
  },
  "test": {
    "fast": [
      "bash test/fast.sh {files}"
    ],
    "full": [
      "bash test/gate.sh"
    ],
    "e2e": [
      "bash test/e2e/run.sh"
    ]
  },
  "round": {
    "dispatch": "subagent",
    "slots": 3,
    "workerCommand": "",
    "accounts": [],
    "operatorCommand": "",
    "sharedPaths": [
      "docs/contributing/market-review-2026-10.md"
    ],
    "roster": [
      "ben",
      "dana",
      "nia",
      "kit",
      "sam"
    ]
  },
  "release": {
    "versionFile": "VERSION"
  },
  "review": {
    "lenses": {
      "security": {
        "paths": [
          "internal/git/**",
          "internal/proc/**",
          "internal/fsio/**",
          "internal/roundlease/**",
          "internal/hook/**",
          "internal/connections/**",
          "internal/harness/**",
          "internal/host/**",
          "internal/reap/**",
          "internal/round/**",
          "internal/hvmigrate/**",
          "internal/extknowledge/**",
          "internal/knowledge/**",
          "internal/ledger/**",
          "internal/migrate/**",
          "internal/projects/**",
          "internal/skills/**",
          "internal/gate/**",
          "internal/doctor/doctor.go",
          "internal/tracker/cli.go",
          "internal/tui/term.go",
          "internal/worker/registry.go",
          "internal/cli/browser.go",
          "internal/cli/hook.go",
          "internal/cli/keepalive.go",
          "internal/cli/testlock.go",
          "internal/cli/deps.go",
          "internal/cli/orchestrate.go"
        ],
        "labels": [
          "risk:security"
        ]
      },
      "ux": {
        "paths": [
          "internal/cli/**"
        ]
      }
    }
  }
}
