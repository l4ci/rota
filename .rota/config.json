{
  "models": {
    "orchestrator": "opus",
    "worker": "sonnet"
  },
  "work": {
    "isolation": "branch",
    "mergeStrategy": "direct",
    "dispatch": "subagent",
    "workerSlots": 3,
    "workerCommand": "",
    "accounts": [],
    "operatorCommand": ""
  },
  "refactor": {
    "confirmBeforeExecute": true
  },
  "learn": {
    "verify": true,
    "promoteThreshold": 3
  },
  "ship": {
    "review": true,
    "secondOpinion": false,
    "secondOpinionRunner": "subagent",
    "qa": false
  },
  "autonomy": {
    "level": "auto"
  },
  "debug": {
    "competingHypotheses": false
  },
  "docs": {
    "path": "docs",
    "autoCreate": true,
    "afterWork": true
  },
  "umbrella": {
    "enabled": false
  },
  "git": {
    "baseBranch": ""
  },
  "qa": {
    "gate": "advisory",
    "afterWork": false
  },
  "issues": {
    "providers": {
      "github": true,
      "gitlab": true
    },
    "provider": "github"
  },
  "rota": {
    "version": "0.9.0"
  },
  "backlog": {
    "backend": "issues"
  },
  "test": {
    "fast": [
      "bash test/fast.sh {files}"
    ],
    "full": [
      "bash test/gate.sh"
    ],
    "e2e": [
      "bash test/e2e/run.sh"
    ]
  }
}
