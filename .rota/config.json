{
  "models": {
    "orchestrator": "opus",
    "worker": "sonnet"
  },
  "work": {
    "isolation": "branch",
    "mergeStrategy": "direct"
  },
  "refactor": {
    "confirmBeforeExecute": true
  },
  "learn": {
    "verify": true,
    "promoteThreshold": 3
  },
  "ship": {
    "review": "light",
    "secondOpinion": false,
    "secondOpinionRunner": "subagent",
    "qa": false
  },
  "autonomy": {
    "level": "auto"
  },
  "docs": {
    "path": "docs",
    "autoCreate": true,
    "afterWork": true
  },
  "umbrella": {
    "enabled": false
  },
  "git": {
    "baseBranch": ""
  },
  "qa": {
    "gate": "advisory",
    "afterWork": false
  },
  "issues": {
    "source": "github"
  },
  "rota": {
    "version": "0.21.0"
  },
  "test": {
    "fast": [
      "bash test/fast.sh {files}"
    ],
    "full": [
      "bash test/gate.sh"
    ],
    "e2e": [
      "bash test/e2e/run.sh"
    ]
  },
  "round": {
    "dispatch": "subagent",
    "slots": 3,
    "workerCommand": "",
    "accounts": [],
    "operatorCommand": "",
    "sharedPaths": [
      "docs/contributing/market-review-2026-10.md"
    ],
    "roster": [
      "ben",
      "dana",
      "nia",
      "kit",
      "sam"
    ]
  },
  "release": {
    "versionFile": "VERSION"
  }
}
