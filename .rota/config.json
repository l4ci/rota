{
  "models": {
    "orchestrator": "opus",
    "worker": "sonnet"
  },
  "work": {
    "isolation": "branch",
    "mergeStrategy": "direct"
  },
  "refactor": {
    "confirmBeforeExecute": true
  },
  "learn": {
    "verify": true,
    "promoteThreshold": 3
  },
  "ship": {
    "review": "light",
    "secondOpinion": false,
    "secondOpinionRunner": "subagent",
    "qa": false
  },
  "autonomy": {
    "level": "auto"
  },
  "docs": {
    "path": "docs",
    "autoCreate": true,
    "afterWork": true
  },
  "umbrella": {
    "enabled": false
  },
  "git": {
    "baseBranch": ""
  },
  "qa": {
    "gate": "advisory",
    "afterWork": false
  },
  "issues": {
    "source": "github"
  },
  "rota": {
    "version": "0.21.0"
  },
  "test": {
    "fast": [
      "bash test/fast.sh {files}"
    ],
    "full": [
      "bash test/gate.sh"
    ],
    "e2e": [
      "bash test/e2e/run.sh"
    ],
    "docs": [
      "bash test/doclint.sh",
      "bash test/grep-gate.sh"
    ],
    "small": [
      "bash test/fast.sh {files}"
    ]
  },
  "round": {
    "dispatch": "subagent",
    "slots": 3,
    "workerCommand": "",
    "accounts": [],
    "operatorCommand": "",
    "sharedPaths": [
      "docs/contributing/market-review-2026-10.md"
    ],
    "roster": [
      "ben",
      "dana",
      "nia",
      "kit",
      "sam"
    ]
  },
  "release": {
    "versionFile": "VERSION"
  },
  "review": {
    "lenses": {
      "security": {
        "paths": [
          "internal/proc/**",
          "internal/fsio/**",
          "internal/git/**",
          "internal/hook/**",
          "internal/tracker/**",
          "internal/roundlease/**",
          "internal/cli/hook.go",
          "internal/cli/browser.go",
          "hooks/**",
          "scripts/**",
          "install.sh",
          "internal/cli/keepalive.go",
          "internal/cli/testlock.go",
          "internal/cli/deps.go",
          "internal/cli/orchestrate.go",
          "internal/tui/term.go",
          "internal/doctor/doctor.go",
          "internal/worker/registry.go",
          "internal/host/**"
        ],
        "labels": [
          "risk:security"
        ]
      },
      "ux": {
        "paths": [
          "internal/cli/exit.go",
          "internal/cli/palette.go",
          "internal/tui/**",
          "docs/usage/**"
        ],
        "labels": [
          "risk:ux"
        ]
      }
    }
  },
  "change": {
    "smallBelow": 100,
    "riskyPaths": [
      "internal/worker/gate*.go",
      "internal/worker/train*.go",
      "internal/worker/verify*.go",
      "internal/worker/changetier.go",
      "internal/change/**",
      "internal/config/**",
      "internal/roundcfg/**",
      ".rota/config.json",
      "test/gate.sh",
      "test/fast.sh",
      "test/runner.sh",
      "test/lib.sh",
      "test/doclint.sh",
      "test/grep-gate.sh",
      "test/validate-skills.py",
      "scripts/skills-docs.py",
      "go.mod",
      "go.sum",
      ".github/**",
      "docs/reference/config-options.md",
      "docs/reference/labels.md",
      "docs/contributing/contract/**",
      "docs/usage/brainstorm.md",
      "docs/usage/configuration.md",
      "install.sh",
      "hooks/**",
      "plugin/**",
      "plugins/**",
      ".claude-plugin/**",
      "internal/hooks/**",
      "internal/host/**",
      "test/sections/**",
      "scripts/**",
      "test/fakes/**",
      "test/e2e/**"
    ],
    "smallPaths": [
      "**/*.go",
      "**/testdata/**",
      "test/lib/**"
    ]
  }
}
